# Vorlage für .env — diese Datei hier enthält keine echten Zugangsdaten und
# gehört ins Repo. Die echte .env gehört NICHT ins Repo (steht in .gitignore).
#
#   cp .env.example .env      und dann die Werte eintragen
#
# Die Werte bekommt ihr von dem Postfach-Anbieter, bei dem info@aquisito.de
# liegt. Meist heißt das dort "SMTP" oder "Postausgangsserver".

# Postausgangsserver, z. B. smtp.strato.de / smtp.ionos.de / smtp.gmail.com
SMTP_HOST=

# 587 für STARTTLS (der Normalfall), 465 für SMTPS.
SMTP_PORT=587

# Benutzername für den Postausgang — in der Regel die volle Mailadresse.
SMTP_USER=

# Passwort bzw. App-Passwort. Wenn der Anbieter App-Passwörter anbietet, nehmt
# eins davon und nicht das Hauptpasswort des Kontos.
SMTP_PASSWORD=

# Absender der Mail. Muss eine Adresse eurer eigenen Domain sein, sonst
# verwirft der Empfänger sie wegen SPF/DKIM oder sortiert sie als Spam ein.
MAIL_FROM=website@aquisito.de

# Wohin die Anfragen gehen.
MAIL_TO=info@aquisito.de
