# Vorlage für .env — diese Datei hier enthält kein echtes Passwort und gehört
# ins Repo. Die echte .env gehört NICHT ins Repo (steht in .gitignore).
#
#   cp .env.example .env
#   nano .env          # nur SMTP_PASSWORD eintragen, der Rest stimmt schon
#
# Danach prüfen:
#   docker compose up -d --build
#   docker compose exec anmeldung python /app/anmeldung.py --selftest

# Postausgangsserver von Strato.
SMTP_HOST=smtp.strato.de

# 587 = STARTTLS. Das ist der Normalfall und funktioniert bei Strato.
# Alternative: 465 (SMTPS) — dann verschlüsselt der Dienst von Anfang an.
# 456 gibt es nicht, das ist ein Zahlendreher aus 465.
SMTP_PORT=587

# Bei Strato ist der Benutzername die vollständige Mailadresse.
#
# EMPFEHLUNG: legt dafür bei Strato ein eigenes Postfach an, etwa
# website@aquisito.de, und tragt das hier ein. Dann steht auf dem Server nicht
# das Passwort eures Haupt-Postfachs. Wird der Server kompromittiert, kann
# jemand darüber nur Mails verschicken — nicht eure gesamte Korrespondenz in
# info@aquisito.de mitlesen. Das Postfach muss nichts können und nichts
# empfangen; es meldet sich nur zum Senden an.
SMTP_USER=info@aquisito.de

# Das Passwort zu SMTP_USER. Nur hier eintragen, nirgends sonst.
SMTP_PASSWORD=

# Alternative statt SMTP_PASSWORD: Pfad zu einer Datei, die nur das Passwort
# enthält — etwa ein Docker-Secret unter /run/secrets/. Dann steht es weder in
# dieser Datei noch in "docker inspect". Ist beides gesetzt, gewinnt die Datei.
# SMTP_PASSWORD_FILE=/run/secrets/smtp_password

# Absender. Strato akzeptiert nur die Adresse, mit der man sich angemeldet
# hat — muss also gleich SMTP_USER bleiben.
MAIL_FROM=info@aquisito.de

# Wohin die Anfragen gehen. Gleich wie der Absender: die Mail landet im
# eigenen Postfach, und "Antworten" geht dank Reply-To direkt an die
# anfragende Person.
MAIL_TO=info@aquisito.de
