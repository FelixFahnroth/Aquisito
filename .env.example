# Vorlage für .env — diese Datei hier enthält keine echten Zugangsdaten und
# gehört ins Repo. Die echte .env gehört NICHT ins Repo (steht in .gitignore).
#
#   cp .env.example .env      und dann die Werte eintragen
#
# Die Werte bekommt ihr von dem Anbieter, bei dem das Postfach info@aquisito.de
# liegt. Gesucht ist der "Postausgangsserver" oder "SMTP".
#
# Danach prüfen:
#   docker compose up -d --build
#   docker compose exec anmeldung python /app/anmeldung.py --selftest

# Postausgangsserver, z. B. smtp.strato.de / smtp.ionos.de / smtp.1blu.de
SMTP_HOST=

# 587 für STARTTLS (der Normalfall), 465 für SMTPS.
SMTP_PORT=587

# Benutzername für den Postausgang. Bei den meisten Anbietern ist das die
# vollständige Mailadresse.
SMTP_USER=info@aquisito.de

# Passwort des Postfachs. Wenn der Anbieter App-Passwörter anbietet, legt eins
# an und tragt das hier ein — dann muss das Hauptpasswort nicht auf den Server.
SMTP_PASSWORD=

# Absender der Mail. Am besten dieselbe Adresse wie SMTP_USER: die meisten
# Mailserver lassen nur die Adresse zu, mit der man sich angemeldet hat, und
# lehnen alles andere ab ("sender address rejected").
MAIL_FROM=info@aquisito.de

# Wohin die Anfragen gehen. Dass Absender und Empfänger gleich sind, ist in
# Ordnung — die Mail landet im eigenen Postfach, und "Antworten" geht dank
# Reply-To direkt an die anfragende Person.
MAIL_TO=info@aquisito.de
