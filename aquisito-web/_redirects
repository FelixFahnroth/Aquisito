# ---------------------------------------------------------------------------
# Documents keep byte-identical paths. This alias exists because the umlaut in
# the real filename is percent-encoded differently by different mail clients:
# %C3%B6 (UTF-8) vs %F6 (Latin-1). A link pasted into an email can arrive as
# either, and only one of them resolves.
# ---------------------------------------------------------------------------
/documents/Aquisito_Foerdermitgliedsantrag.pdf  /documents/Aquisito_Fördermitgliedsantrag.pdf  301

# ---------------------------------------------------------------------------
# The MyST build served assets from /images/ and /videos/. Anything hotlinked
# from a newsletter or a partner site still resolves.
# ---------------------------------------------------------------------------
/images/*               /assets/img/:splat           301
/videos/*               /assets/video/:splat         301

